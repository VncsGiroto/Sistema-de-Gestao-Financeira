POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=financeway
JWT_SECRET=troque-por-32-chars-aleatorios
NGINX_PORT=8080
VITE_API_URL=/api
# hardening (6.1): em prod use ENV=prod, COOKIE_SECURE=true e CORS com o domínio real
ENV=dev
# anti-bruteforce no login (req/min/IP); a suite E2E faz ~11 logins, então o job E2E
# do CI sobe o compose com LOGIN_RATE_LIMIT=60 (prod mantém 10)
LOGIN_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
# mercado (7.2a): gere em brapi.dev; Somente servidor — nunca commite um token real
BRAPI_TOKEN=
